{
	"name": "git-add-force",
	"displayName": "Git add force",
	"publisher": "DreamingCodes",
	"description": "Add git add --force to the vscode right click menu",
	"version": "0.0.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/Dreaming-Codes/git-add-force"
	},
	"engines": {
		"vscode": "^1.106.1"
	},
	"categories": ["Other"],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "git-add-force.addForce",
				"title": "Add File to Git (force)"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "git-add-force.addForce",
					"group": "7_modification",
					"when": "explorerResourceIsFolder || !explorerResourceIsFolder"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run package",
		"compile": "bun run check-types && bun run lint && rolldown -c rolldown.config.mjs",
		"watch": "bun run --parallel watch:rolldown watch:tsc",
		"watch:rolldown": "rolldown -c rolldown.config.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "bun run check-types && bun run lint && NODE_ENV=production rolldown -c rolldown.config.mjs",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "bun run compile-tests && bun run compile && bun run lint",
		"check-types": "tsc --noEmit",
		"lint": "biome check .",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/vscode": "^1.106.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@biomejs/biome": "^1.9.4",
		"rolldown": "^1.0.0-beta.9",
		"typescript": "^5.9.3",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2"
	}
}
